PREFIX schema: <http://schema.org/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT ?image ?coord ?description
WHERE {
  OPTIONAL {
    <${iri}> wdt:P18 ?image .
  }

  OPTIONAL {
    <${iri}> wdt:P625 ?coord .
  }

  OPTIONAL {
    <${iri}> schema:description ?description .
    FILTER(LANG(?description) = "en")
  }
}